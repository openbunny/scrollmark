{
  "name": "scrollmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "OpenBunny",
  "homepage": "https://github.com/openbunny/scrollmark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbunny/scrollmark.git"
  },
  "bugs": {
    "url": "https://github.com/openbunny/scrollmark/issues"
  },
  "description": "Resume X profiles where you left off, as a Safari web extension.",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build": "bun src/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "bun test",
    "knip": "knip",
    "cspell": "cspell lint --no-progress .",
    "lint:html": "html-validate 'Resources/*.html'",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages --excludePackages \"@cspell/dict-en-common-misspellings@2.2.2\" --onlyAllow \"MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;BlueOak-1.0.0;Python-2.0;CC-BY-4.0;CC-BY-3.0\""
  },
  "dependencies": {
    "@openbunny/theme": "file:../openbunny-theme/packages/web"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/jsdom": "30.0.0",
    "cspell": "10.1.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "html-validate": "11.15.0",
    "jsdom": "30.0.1",
    "knip": "6.33.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
